<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style Selector=".Compact ToggleSwitch /template/ Border#OuterBorder, .Compact ToggleSwitch /template/ Border#SwitchKnobBounds">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="20" />
        <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector=".Compact ToggleSwitch /template/ Grid#PART_MovingKnobs, .Compact ToggleSwitch /template/ Canvas#PART_SwitchKnob">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
    </Style>
        <Style Selector=".Compact ToggleSwitch /template/ Ellipse#SwitchKnobOn">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Margin" Value="0,0,16,0" />
    </Style>
    <Style Selector=".Compact ToggleSwitch /template/ Ellipse#SwitchKnobOff">
        <Setter Property="Width" Value="10" />
        <Setter Property="Height" Value="10" />
    </Style>
</Styles>