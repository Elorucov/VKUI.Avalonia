<ResourceDictionary xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:VKUI.Controls">
  <Design.PreviewWith>
    <controls:Avatar Width="24" Height="24" Margin="12" Initials="WW" ImageSource="avares://VKUI.Avalonia.Demo/Assets/elor.jpg"/>
  </Design.PreviewWith>

  <ControlTheme x:Key="{x:Type controls:Avatar}" TargetType="controls:Avatar">
    <Setter Property="Background" Value="{DynamicResource VKColorBackgroundSecondary}"/>
    <Setter Property="Foreground" Value="{DynamicResource VKColorIconSecondary}"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Grid>
          <Viewbox>
            <Grid Width="48" Height="48" HorizontalAlignment="Center" VerticalAlignment="Center">
              <Ellipse x:Name="GradientEllipse" Width="48" Height="48" Fill="{TemplateBinding Background}"/>
              <TextBlock x:Name="Initials" VerticalAlignment="Center" HorizontalAlignment="Center" Classes="Display" FontWeight="Medium" FontSize="16" LineHeight="20" Foreground="{TemplateBinding Foreground}" Text="{TemplateBinding Initials}"/>
            </Grid>
          </Viewbox>
          <Image x:Name="ImagePresenter" HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="UniformToFill">
            <Image.Clip>
              <EllipseGeometry Center="24,24" RadiusX="24" RadiusY="24"/>
            </Image.Clip>
          </Image>
        </Grid>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>