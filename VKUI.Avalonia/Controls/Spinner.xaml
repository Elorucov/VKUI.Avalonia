<ResourceDictionary xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:VKUI.Controls">
  <Design.PreviewWith>
    <controls:Spinner Size="ExtraLarge"/>
  </Design.PreviewWith>

  <ControlTheme x:Key="{x:Type controls:Spinner}" TargetType="controls:Spinner">
    <Setter Property="Foreground" Value="{DynamicResource VKColorIconMedium}"/>
    <Setter Property="RenderTransform">
      <Setter.Value>
        <RotateTransform/>
      </Setter.Value>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <controls:VKIcon x:Name="Icon" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}"/>
      </ControlTemplate>
    </Setter>
    
    <Style Selector="^:animating">
      <Style.Animations>
        <Animation Duration="0:0:0.7" IterationCount="Infinite">
          <KeyFrame Cue="0%">
            <Setter Property="RotateTransform.Angle" Value="0"/>
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="RotateTransform.Angle" Value="360"/>
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
  </ControlTheme>
</ResourceDictionary>
